{
  "siteName": "Freewebnovel",
  "urlPattern": "freewebnovel.com",
  "isActive": true,
  "strategyName": "common",
  "hasPagination": true,
  "paginationType": "?page={0}",
  "paginationQueryPartial": "?page=",
  "hasNovelInfoOnDifferentPage": false,
  "chaptersPerPage": 40,
  "pageOffSet": 0,
  "completedStatus": "completed",
  "hasImagesForChapterContent": false,
  "hasPremiumChapters": false,
  "entireSiteRequiresSelenium": false,
  "tableOfContentsRequiresSelenium": false,
  "chapterContentRequiresSelenium": false,
  "requiresFlareSolverr": true,
  "cloudflareProtection": "detected",
  "chapterSortOrder": "ascending",
  "selectors": {
    "tableOfContents": {
      "chapterLinks": "//*[@id='idData']//a/@href",
      "lastTableOfContentsPage": "//*[@id='barcon']/a[@data-page-action='last']",
      "lastTableOfContentPageNumberAttribute": "data-page-action",
      "latestChapterLink": "//*[@id='indexListPage']/div/div/div[1]/div[2]/ul/li[1]/a",
      "novelStatus": "//*[@id='indexListPage']/div/div/div[1]/div[1]/div[2]/div[2]/div[2]/div[5]/div/span/a/text()",
      "novelAuthor": "//*[@id='indexListPage']/div/div/div[1]/div[1]/div[2]/div[2]/div[2]/div[2]/div/a/text()",
      "novelAlternativeNames": null,
      "novelGenres": "//*[@id='indexListPage']/div/div/div[1]/div[1]/div[2]/div[2]/div[2]/div[3]/div/a/text()",
      "novelRating": null,
      "novelTitle": "//h1",
      "totalRatings": null,
      "novelDescription": "//*[@id='indexListPage']/div/div/div[1]/div[1]/div[2]/div[3]/div[3]/div/p/text()",
      "novelThumbnailUrl": "//*[@id='indexListPage']/div/div/div[1]/div[1]/div[2]/div[2]/div[1]/picture/img",
      "thumbnailUrlAttribute": "src"
    },
    "chapterTitle": "//*[@id='main1']/div[1]/div/div[1]/span/text()",
    "chapterContent": "//*[@id='article']/p",
    "alternativeChapterContent": null,
    "chapterContentImageUrlAttribute": null,
    "nextChapterButton": "//*[@id='next_url']"
  }
}
