{
  "siteName": "NovelBin",
  "urlPattern": "novelbin.me",
  "isActive": true,
  "strategyName": "novelbin",
  "hasPagination": false,
  "paginationType": null,
  "paginationQueryPartial": null,
  "hasNovelInfoOnDifferentPage": false,
  "chaptersPerPage": -1,
  "pageOffSet": 0,
  "completedStatus": "completed",
  "hasImagesForChapterContent": false,
  "hasPremiumChapters": false,
  "entireSiteRequiresSelenium": false,
  "tableOfContentsRequiresSelenium": true,
  "chapterContentRequiresSelenium": false,
  "requiresFlareSolverr": false,
  "cloudflareProtection": "jschallenge",
  "chapterSortOrder": "Ascending",
  "selectors": {
    "tableOfContents": {
      "chapterLinks": "//ul[@class='list-chapter']/li/a",
      "chapterTitleInToc": "./span[@class='chapter-title']",
      "tableOfContentsPaginationListItems": null,
      "lastTableOfContentsPage": null,
      "lastTableOfContentPageNumberAttribute": null,
      "latestChapterLink": "//div[@class='l-chapter']//a[@class='chapter-title']",
      "novelStatus": "//ul[@class='info info-meta']//li[h3[text()='Status:']]/a",
      "novelAuthor": "//ul[@class='info info-meta']//li[h3[text()='Author:']]/a",
      "novelAlternativeNames": null,
      "novelGenres": "//ul[@class='info info-meta']//li[h3[text()='Genre:']]/a",
      "novelRating": "//span[@itemprop='ratingValue']",
      "novelTitle": "//h3[@class='title'][@itemprop='name']",
      "totalRatings": "//span[@itemprop='reviewCount']",
      "novelDescription": "//div[@class='desc-text'][@itemprop='description']/p",
      "novelThumbnailUrl": "//div[@class='book']/img[@class='lazy']",
      "thumbnailUrlAttribute": "src"
    },
    "chapterTitle": "//h2/a[@class='chr-title']/span[@class='chr-text']",
    "chapterContent": "//div[@id='chr-content']//p",
    "alternativeChapterContent": "//p",
    "chapterContentImageUrlAttribute": null
  }
}
